# ---------------------------------------------------------------------------
# Website Opportunity Engine — environment template
#
# Copy to `.env.local` and fill in what you need. Every value below is optional:
# with an empty file the app runs in demo mode against local fixtures.
#
# NEVER commit real keys. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# --- Mode ------------------------------------------------------------------
# true  : all providers served from local fixtures, in-memory store, no auth needed.
# false : live providers and Supabase. Anything without a key reports "not run".
DEMO_MODE=true

# Used to build report URLs in the CSV export.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (database, auth, storage) -------------------------------------
# Required when DEMO_MODE=false. The service-role key is server-only and must never
# be exposed to the browser — do not prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=website-screenshots

# --- Website scraping -------------------------------------------------------
# Firecrawl renders JavaScript and captures screenshots. Without a key the app falls
# back to a built-in direct HTTP scraper (no JS rendering, no screenshots).
FIRECRAWL_API_KEY=

# --- Performance ------------------------------------------------------------
# Google PageSpeed Insights. Without a key, performance is reported as not measured
# and is excluded from the transformation-need score rather than counted as a failure.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- AI analysis and outreach ----------------------------------------------
# Without a key, sector detection, website interpretation and outreach report
# "not run" and the affected companies are flagged for manual review.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Competitor discovery ---------------------------------------------------
# Serper.dev (or swap the adapter in src/providers/search.ts for another SERP API).
# Without a key, competitor discovery is skipped and the limitation is reported on
# every company; the final score drops the competitor term rather than assuming one.
SERPER_API_KEY=

# --- Background jobs --------------------------------------------------------
# Trigger.dev. Without a key, batches run on the built-in in-process runner with the
# same retry, concurrency and idempotency behaviour.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- Tuning -----------------------------------------------------------------
# How many company pipelines run at once. Raise carefully: it multiplies your
# request rate against every provider.
PIPELINE_CONCURRENCY=4
MAX_COMPANIES_PER_BATCH=50

# --- Demo store -------------------------------------------------------------
# The demo store mirrors itself to disk so a local dev session survives a reload.
# Set to false for ephemeral, in-process-only state (the test suite does this).
DEMO_PERSIST=true
DEMO_DATA_DIR=.data
